# PostgreSQL superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password

# App DB user (created by docker/postgres/init.sh)
DB_USERNAME=digital_library_user
DB_PASSWORD=change-this-db-password

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# DeepSeek AI
DEEPSEEK_API_KEY=sk-your-key-here

# Internal service communication
INTERNAL_API_KEY=change-this-in-production


CORS_ALLOWED_ORIGIN=http://your-server-ip-or-domain

# Grafana (if monitoring enabled)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-this-password

# Paths to book files on host machine
BOOKS_PATH=/mnt/books
COVERS_PATH=/mnt/books/covers
