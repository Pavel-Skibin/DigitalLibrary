{

    "id": null,
    "uid": "k6-load-testing",
    "title": "K6 Load Testing Results",
    "tags": ["k6", "load-testing"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Virtual Users",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "k6_vus",
            "legendFormat": "Active VUs"
          },
          {
            "expr": "k6_vus_max",
            "legendFormat": "Max VUs"
          }
        ]
      },
      {
        "id": 2,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(k6_http_reqs[1m])",
            "legendFormat": "Requests/sec"
          }
        ]
      },
      {
        "id": 3,
        "title": "Request Duration",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "k6_http_req_duration{quantile='0.95'}",
            "legendFormat": "p95"
          },
          {
            "expr": "k6_http_req_duration{quantile='0.99'}",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 4,
        "title": "Failed Requests %",
        "type": "graph",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(k6_http_req_failed[1m]) * 100",
            "legendFormat": "Failed %"
          }
        ]
      }
    ]
}
