# Service
SERVICE_NAME=ai-service
SERVICE_PORT=8085
DEBUG=True

# ============================================================
# ВАЖНО: AI Service НЕ подключается к PostgreSQL напрямую!
# ============================================================
# Вместо этого используются REST API других микросервисов:
# - User Service (http://localhost:8081) - история, избранное
# - Book Catalog Service (http://localhost:8091) - метаданные книг
# - Comment Rating Service (http://localhost:8082) - оценки
#
# AI Service ПИШЕТ только в:
#   ✅ Qdrant (векторы книг)
#   ✅ Redis (кэш)
#
# AI Service ЧИТАЕТ из:
#   ✅ REST API других сервисов
#   ✅ Redis (кэш)
# ============================================================

# Другие микросервисы (REST API)
USER_SERVICE_URL=http://localhost:8081
BOOK_CATALOG_SERVICE_URL=http://localhost:8091
COMMENT_RATING_SERVICE_URL=http://localhost:8082

# Qdrant (в Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_RECOMMENDATIONS=books_recommendations
QDRANT_COLLECTION_RAG=books_rag_chunks

# Redis (в Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Embedding Model
EMBEDDING_MODEL_NAME=ai-forever/ru-en-RoSBERTa
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Recommendation params
TOP_K_SIMILAR=50
FINAL_RECOMMENDATIONS=10
MMR_DIVERSITY_LAMBDA=0.5
MAX_PER_AUTHOR=2
MAX_PER_GENRE=3

# Cache TTL (seconds)
CACHE_TTL_RECOMMENDATIONS=3600
CACHE_TTL_SIMILAR_BOOKS=604800
CACHE_TTL_EMBEDDINGS=2592000

# Logging
LOG_LEVEL=INFO

# Security (для межсервисного взаимодействия)
INTERNAL_API_KEY=change-this-secret-key-in-production
JWT_PASSTHROUGH=true

# Message Queue (опционально, для асинхронной генерации embeddings)
ENABLE_MESSAGE_QUEUE=false
MESSAGE_QUEUE_TYPE=redis
MESSAGE_QUEUE_STREAM_BOOK_CREATED=book:created
MESSAGE_QUEUE_STREAM_BOOK_UPDATED=book:updated
MESSAGE_QUEUE_CONSUMER_GROUP=ai-service-embeddings

# Hybrid Search (BM25 + Vector)
ENABLE_HYBRID_SEARCH=true
HYBRID_SEARCH_WEIGHT_DENSE=0.7
HYBRID_SEARCH_WEIGHT_SPARSE=0.3

# ─── DeepSeek LLM (RAG Phase 6-7) ──────────────────────────────────────────
# Получить ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama fallback (локальная LLM, если нет DeepSeek ключа)
ENABLE_LOCAL_LLM_FALLBACK=false
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=mistral:7b
